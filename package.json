{
  "name": "usethishook",
  "version": "0.1.0",
  "description": "A collection of reusable React hooks for everyday UI, state, and browser APIs.",
  "license": "MIT",
  "author": {
    "name": "Senthil Kumar Thangavel",
    "url": "https://senthilkumar.mentorbridge.in"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "react",
    "hooks",
    "custom-hooks",
    "typescript",
    "usethishook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/usethishook.git"
  },
  "bugs": {
    "url": "https://github.com/senthilkumar979/usethishook/issues"
  },
  "homepage": "https://github.com/senthilkumar979/usethishook#readme"
}
